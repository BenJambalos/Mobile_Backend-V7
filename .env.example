# Copy this file to .env and fill in real values before running the server.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=hyquai_app
DB_PASSWORD=hyquai_dev_pw
DB_NAME=hyquai_db

# --- Auth ---
# Generate a real random string for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=4000

# --- Railway (production) ---
# On Railway you don't need DB_* at all: the backend falls back to the
# MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
# variables that Railway's MySQL service exposes. Link them to this
# service (Variables > Add Reference) and also set:
#   JWT_SECRET=<long random string>
#   NODE_ENV=production
# Railway sets PORT itself. Set the service's Root Directory to
# hyqual_backend if your repo also contains the Flutter app.

# --- Device liveness (optional) ---
# A device that has not contacted the API for this many seconds is shown as
# OFFLINE. The ESP32 contacts the API about once a minute; minimum 30.
# DEVICE_OFFLINE_AFTER_SECONDS=180
# Set to "off" to disable the background job that raises "Device Offline"
# notifications (OFFLINE detection itself keeps working).
# DEVICE_OFFLINE_MONITOR=on

# --- Device moves and the critical alarm (optional) ---
# After a device is moved to another pond, that pond shows as online ("waiting for
# first reading") for this many seconds while it waits for the device's first
# reading there. After that, with still no reading, it shows OFFLINE. Minimum 60.
# POND_FIRST_READING_GRACE_SECONDS=600
# The app's loud alarm only rings for readings newer than this many seconds
# (default 20 minutes). Minimum 60.
# ALARM_MAX_READING_AGE_SECONDS=1200

# --- Salinity unit (optional) ---
# The ESP32 sends the EC probe's conductivity (mS/cm) in the `salinity` field. The
# backend converts it to ppt (UNESCO PSS-78) before storing it, because the app's
# thresholds, the alerts and the ML service all use ppt. A reading may say what
# unit it is in with `salinityUnit` ("mS/cm", "uS/cm" or "ppt"); this is what a
# reading WITHOUT a unit is taken to be. The shipped firmware never said, so the
# default is mS/cm. Change it to ppt only if every device already sends ppt.
# SALINITY_DEFAULT_UNIT=mS/cm
